# Copy to /etc/wildlinge-poster.env (chmod 600). Without all four X keys the poster only prints (dry run).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
POSTER_LANG=en
POSTER_MAX_PER_DAY=6
POSTER_MIN_GAP_MIN=90
POSTER_URL=https://plimploms.com
POSTER_TAGS=#ArtificialLife #Plimploms
# POSTER_DRY=1
